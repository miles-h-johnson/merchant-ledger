DATABASE_URL=postgresql://user:password@localhost:5432/merchant_ledger
# Price workbook exported from the server's market registry (single sheet, "Sheet1")
LR_WORKBOOK_PATH=data/raw/lr_economy_workbook.xlsx
# Recipes and item names are read from the installed game and its unpacked mod cache
VINTAGE_STORY_INSTALL_DIR=C:/Games/Vintagestory
VINTAGE_STORY_DATA_DIR=C:/Users/<you>/AppData/Roaming/VintagestoryData
PORT=5000
